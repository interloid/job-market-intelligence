PROJECT_NAME=job-market-intelligence-api
PROJECT_DESCRIPTION=A centralized platform that collects job postings from multiple sources, validates and standardizes the data, and identifies duplicate listings.It provides reliable job data through REST APIs while tracking ingestion activities, data quality, and job lifecycle changes.
VERSION=1.0.0
DOCS_URL=/docs
REDOC_URL= /redoc
DEBUG=True

DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/adip
PREFECT_DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/adip

APP_ENV=development
DB_ECHO=false
LOG_LEVEL=INFO

DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=your_aws_region
S3_BUCKET_NAME=your_aws_s3_bucket_name

